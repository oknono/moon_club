<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg?v={{ build }}" />
    <title>{% if page.url != "/" %}{{ title }} · {% endif %}Moon Cat Social Club</title>
    <meta name="description" content="Gatherings by invitation. Capacity eight." />
    <link rel="stylesheet" href="/css/fonts.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/tokens.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/base.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/layout.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/components.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/theme-toggle.css?v={{ build }}" />
    {%- if page.url == "/styleguide/" %}
    <link rel="stylesheet" href="/css/styleguide.css?v={{ build }}" />
    {%- endif %}
    <script src="/js/theme.js?v={{ build }}"></script>
  </head>
  <body>
    {#- Outside the page column so it never competes with the title -#}
    <div class="topbar">
      {% include "sky-toggle.njk" %}
    </div>
    <div class="site">
      <header class="masthead">
        {#- The home page has no heading of its own, so the title is its h1.
            Glyph letters map to the Egyptian font: b = scarab, l = ibis -#}
        {%- set titleTag = "h1" if page.url == "/" else "p" %}
        <{{ titleTag }} class="masthead__title">
          <span class="glyph" aria-hidden="true">b</span>
          <span class="masthead__name">The Moon Cat's Social Club</span>
          <span class="glyph" aria-hidden="true">l</span>
        </{{ titleTag }}>
        <nav class="nav" aria-label="Main">
          <ul class="nav__list">
            {%- for item in nav %}
            <li>
              <a class="nav__item" href="{{ item.url }}"
                {%- if page.url == item.url %} aria-current="page"{% endif %}>
                <span class="nav__glyph glyph" aria-hidden="true">{{ item.glyph }}</span>
                <span class="nav__label">{{ item.label }}</span>
              </a>
            </li>
            {%- endfor %}
          </ul>
        </nav>
      </header>

      <main class="page">
        {{ content | safe }}
      </main>

      <footer class="footer">
        <p class="footer__fine">
          Built by the Familiar, under supervision. Complaints go to the window.
        </p>
      </footer>
    </div>
  </body>
</html>
