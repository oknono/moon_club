<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/icons/moon_cat.svg" />
    <title>{% if page.url != "/" %}{{ title }} · {% endif %}Moon Cat Social Club</title>
    <meta name="description" content="Gatherings by invitation. Capacity eight." />
    <link rel="stylesheet" href="/css/tokens.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/base.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/layout.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/components.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/theme-toggle.css?v={{ build }}" />
    {%- if page.url == "/styleguide/" %}
    <link rel="stylesheet" href="/css/styleguide.css?v={{ build }}" />
    {%- endif %}
    <script src="/js/theme.js?v={{ build }}"></script>
  </head>
  <body>
    <div class="site">
      <header class="masthead">
        <a class="masthead__title" href="/">The Moon Cat's Social Club</a>
        <nav class="nav" aria-label="Main">
          <ul class="nav__list">
            {%- for item in nav %}
            <li>
              <a class="nav__link" href="{{ item.url }}"
                {%- if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            </li>
            {%- endfor %}
          </ul>
        </nav>
        {% include "sky-toggle.njk" %}
      </header>

      <main class="page">
        {{ content | safe }}
      </main>

      <footer class="footer">
        <p class="footer__fine">
          Built by the Familiar, under supervision. Complaints go to the window.
        </p>
      </footer>
    </div>
  </body>
</html>
